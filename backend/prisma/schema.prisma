// Prisma Schema for MathChampions Ghana
// Database: PostgreSQL

generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Base user model for authentication
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  
  // Relations
  parent       Parent?
  
  @@map("users")
}

// Parent profile
model Parent {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phoneNumber String?  @map("phone_number") // optional: sign-up only asks for what's needed to play
  createdAt   DateTime @default(now()) @map("created_at")
  
  // Relations
  students    Student[]
  
  @@map("parents")
}

// Student (child) profile
model Student {
  id          String   @id @default(uuid())
  parentId    String   @map("parent_id")
  parent      Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name        String
  avatar      String   // lion, elephant, cheetah, monkey, eagle, fish
  gradeLevel  String   @map("grade_level") // KG1, KG2, P1, P2, P3
  dateOfBirth DateTime? @map("date_of_birth") @db.Date // optional at sign-up
  createdAt   DateTime @default(now()) @map("created_at")
  
  // Adventure World wallet
  coins        Int       @default(0)
  equippedItem String?   @map("equipped_item") // item id from world_content.ITEMS
  lastChestAt  DateTime? @map("last_chest_at")

  // Relations
  gameSessions GameSession[]
  nodeProgress NodeProgress[]
  items        StudentItem[]
  events       Event[]
  
  @@map("students")
}

// Question bank for math problems
model Question {
  id            String   @id @default(uuid())
  topic         String   // counting, addition, subtraction, multiplication
  gradeLevel    String   @map("grade_level") // KG1, KG2, P1, P2, P3
  difficulty    Int      // 1-5
  questionText  String   @map("question_text") @db.Text
  correctAnswer Int      @map("correct_answer")
  option1       Int
  option2       Int
  option3       Int
  option4       Int
  explanation   String?  @db.Text
  imageUrl      String?  @map("image_url")
  // Nullable until every environment has run scripts/backfill_question_skills.py
  skillId       String?  @map("skill_id")
  createdAt     DateTime @default(now()) @map("created_at")
  
  // Relations
  skill         Skill?   @relation(fields: [skillId], references: [id])
  answers       Answer[]
  
  @@index([skillId])
  @@map("questions")
}

// Maths skill graph; content lives in app/skills_content.py, synced by scripts/sync_skills.py
model Skill {
  id                String   @id // slug, e.g. p1-add-within-20
  naccaCode         String?  @map("nacca_code") // closest NaCCA indicator; shared by add + subtract
  gradeLevel        String   @map("grade_level")
  strand            String
  topic             String
  title             String
  parentDescription String   @map("parent_description") @db.Text
  prerequisiteIds   String[] @map("prerequisite_ids")
  order             Int      @map("sort_order")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  questions Question[]

  @@map("skills")
}

// Game session (practice or battle)
model GameSession {
  id              String    @id @default(uuid())
  studentId       String    @map("student_id")
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionType     String    @map("session_type") // practice, battle
  topic           String
  gradeLevel      String    @map("grade_level")
  totalQuestions  Int       @map("total_questions")
  correctAnswers  Int       @default(0) @map("correct_answers")
  wrongAnswers    Int       @default(0) @map("wrong_answers")
  totalTimeSpent  Int       @default(0) @map("total_time_spent") // seconds
  starsEarned     Int       @default(0) @map("stars_earned")
  completed       Boolean   @default(false)
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")
  clientId        String?   @unique @map("client_id") // set for sessions played offline, so a resend isn't counted twice
  
  // Relations
  answers         Answer[]
  
  @@map("game_sessions")
}

// Individual answer record
model Answer {
  id             String      @id @default(uuid())
  sessionId      String      @map("session_id")
  session        GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId     String      @map("question_id")
  question       Question    @relation(fields: [questionId], references: [id])
  selectedAnswer Int         @map("selected_answer")
  isCorrect      Boolean     @map("is_correct")
  timeSpent      Int         @map("time_spent") // seconds
  answeredAt     DateTime    @default(now()) @map("answered_at")
  
  @@unique([sessionId, questionId])
  
  @@map("answers")
}

// Progress on one Adventure World node (node ids live in app/world_content.py)
model NodeProgress {
  id           String   @id @default(uuid())
  studentId    String   @map("student_id")
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  nodeId       String   @map("node_id")
  stars        Int      @default(0) // best result, 0-3
  bestAccuracy Float    @default(0) @map("best_accuracy")
  plays        Int      @default(0)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([studentId, nodeId])
  @@map("node_progress")
}

// Analytics event from the app (map opened, stage finished, chest opened...)
// for retention metrics; names are listed in app/routers/events.py
model Event {
  id         String   @id @default(uuid())
  clientId   String   @unique @map("client_id") // generated on the device, so offline retries don't double count
  studentId  String   @map("student_id")
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name       String
  props      Json?
  occurredAt DateTime @map("occurred_at") // device time, clamped to the server's now
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([studentId, occurredAt])
  @@index([name, occurredAt])
  @@map("events")
}

// Collectible or outfit owned by a student (item ids live in app/world_content.py)
model StudentItem {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  itemId     String   @map("item_id")
  acquiredAt DateTime @default(now()) @map("acquired_at")

  @@unique([studentId, itemId])
  @@map("student_items")
}
