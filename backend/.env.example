# Database (local Docker or Render Postgres URL in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mathchampions

# Redis (optional in production; leave default or use Upstash)
REDIS_URL=redis://localhost:6379

# JWT (use a long random secret in production)
JWT_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Admin
ADMIN_SEED_TOKEN=replace-with-admin-token

# CORS: comma-separated origins (production: add your Vercel URL)
# Example: https://mathchampions.vercel.app,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
